# ==============================================================================
# MEGS Environment Variables Template (Full Stack)
# Refer to backend/.env.example and frontend/.env.example for individual configurations.
# ==============================================================================

# --- Backend Configuration ---
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
PORT=3000
NODE_ENV=development
# Production: use exact HTTPS frontend origins; allow previews individually.
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS=""
# Production requires explicit trust; set 1 only after verifying one mandatory proxy hop.
TRUST_PROXY="false"
# Production requires shared Redis for rate limits and logout token revocation.
REDIS_URL=""
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWT_ALGORITHMS="HS256,RS256,ES256"
SUPABASE_JWT_AUDIENCE="authenticated"
OTP_SECRET="replace-with-a-random-otp-hmac-secret"
BACKUP_ENCRYPTION_SECRET="replace-with-a-random-backup-encryption-secret"
BACKUP_ENCRYPTION_KEY_ID="v1"
# Decryption-only history. Keep actual values private; never infer them from new master credentials.
BACKUP_ENCRYPTION_LEGACY_KEYS='{}'
BACKUP_ENCRYPTION_LEGACY_SECRETS=""
# Optional exact HTTPS hostnames for old resume URLs; Supabase hostname is already allowed.
LEGACY_RESUME_HOSTS=""
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GMAIL_USER="your-organization-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="MEGS Recruitment (your-organization-email@gmail.com)"

# --- Frontend Configuration ---
VITE_API_URL="http://localhost:3000/api"
VITE_ENABLE_QUERY_DEVTOOLS="false"
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."
VITE_DISABLE_CAPTCHA="false"

# --- Cloudflare Turnstile CAPTCHA (Server-Side) ---
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"
DISABLE_CAPTCHA="false"
DISABLE_RATE_LIMIT="false"
DISABLE_OTP="false"
DISABLE_MFA="false"
