# ==============================================================================
# MEGS Production .gitignore
# Minimal, Clean Production Repository Configuration
# ==============================================================================

# 1. Dependencies & Worktrees
node_modules/
.pnp
.pnp.js
worktrees/
.worktrees/

# 2. Environment Variables & Secrets — NEVER COMMIT
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# 3. Build & Compilation Outputs
dist/
build/
out/
.next/
.nuxt/
.turbo/
*.tsbuildinfo
storage/
*.enc.gz

# 4. Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Tests, Unit Specs & E2E Suites
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
e2e/
playwright.config.ts
test-results/
playwright-report/
blob-report/
coverage/
playwright/.cache/

# 6. Audit Suites, Dev Scripts & Screenshots
frontend-audit/
screenshots/
backend/scripts/
backend/src/scripts/
src/pages/dev/
frontend/src/pages/dev/
scratch/
*.audit.*

# 7. Internal AI Agents, Superpowers & Sprint Documentation
.agents/
.superpowers/
agent/
AGENTS.md
docs/
DATABASE_SCHEMA_EXPORTER.html
database_diagrams.html

# 8. IDE, Editor & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
desktop.ini
