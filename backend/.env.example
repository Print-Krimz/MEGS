# ==============================================================================
# MEGS Backend Environment Variables Template
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# PostgreSQL Connection Strings (Supabase with pgvector)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Backend Server Port
PORT=3000
NODE_ENV=development

# Production security (the server refuses to start in production without these)
# Exact HTTPS frontend origin; add preview origins individually (comma-separated).
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS=""
# Optional link base for invitation emails; defaults to FRONTEND_URL.
# APP_URL="https://your-frontend.example.com"
# Set 1 only after verifying exactly one trusted proxy hop (e.g. Heroku router).
TRUST_PROXY="false"
# Rate counters and logout revocation are stored in PostgreSQL; apply all migrations first.

# Supabase Auth & Storage Configuration
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWT_ALGORITHMS="HS256,RS256,ES256"
SUPABASE_JWT_AUDIENCE="authenticated"
# Optional override; defaults to ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER="https://[YOUR_PROJECT_REF].supabase.co/auth/v1"

# Dedicated secrets; use independently generated values of at least 32 characters.
OTP_SECRET="replace-with-a-random-otp-hmac-secret"
BACKUP_ENCRYPTION_SECRET="replace-with-a-random-backup-encryption-secret"
BACKUP_ENCRYPTION_KEY_ID="v1"
# Rotation/recovery only. JSON maps prior versioned key IDs to secrets.
# BACKUP_ENCRYPTION_LEGACY_KEYS='{"v0":"previous-secret-at-least-32-characters"}'
# For pre-versioned .enc.gz files only; comma-separated and temporary during migration.
# BACKUP_ENCRYPTION_LEGACY_SECRETS="previous-secret-at-least-32-characters"
# Optional exact HTTPS hostnames for old resume URLs; the Supabase hostname is already allowed.
LEGACY_RESUME_HOSTS=""

# Google Gemini AI API Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Email Configuration (Nodemailer / Gmail SMTP)
GMAIL_USER="your-organization-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="MEGS Recruitment (your-organization-email@gmail.com)"
# Optional generic SMTP instead of Gmail
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-username"
# SMTP_PASS="smtp-password"

# Feature Flags & Scoring Configuration (Optional)
DYNAMIC_CANDIDATE_SCORING_ENABLED="true"
KNN_TALENT_POOLING_ENABLED="true"
CANDIDATE_SCORE_REVALIDATION_ENABLED="true"
# Developer-owned only. On Heroku set these in app Settings > Config Vars.
# true disables the control for the demo; false/unset restores enforcement.
# No MEGS administrator dashboard or database override can change these flags.
DISABLE_RATE_LIMIT="false"
DISABLE_MFA="false" # set to "true" to bypass staff MFA
DISABLE_OTP="false" # set to "true" to bypass registration/reset OTP code comparison

# Initial Database Seed Bootstrap Credentials (Used by npm run seed)
ADMIN_EMAIL="set-an-explicit-admin-email"
ADMIN_PASSWORD="set-an-explicit-unique-admin-password"
ADMIN_NAME="System Administrator"
TA_EMAIL="set-an-explicit-ta-email"
TA_PASSWORD="set-an-explicit-unique-ta-password"
TA_NAME="Talent Acquisition"

# Cloudflare Turnstile CAPTCHA Bot Protection (server-only secret; never expose via VITE_*)
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
# Comma-separated hostnames where the widget runs (your frontend domain in production).
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"
# Ignored in production; only honored when NODE_ENV is development or test.
DISABLE_CAPTCHA="false"

