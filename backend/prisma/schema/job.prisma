// ─────────────────────────────────────────────
// JOB POSTING
// Created and managed by Talent Acquisition staff.
// Applicants browse and apply to these.
// ─────────────────────────────────────────────

model JobPosting {
  id         Int    @id @default(autoincrement())
  postedById String // UUID — matches User.id from Supabase Auth
  postedBy   User   @relation(fields: [postedById], references: [id])

  title        String
  description  String
  requirements String    // Gemini API compares the resume against this text
  location     String?
  imageUrl     String?
  // Nullable until a separate location-data policy supplies coordinates.
  latitude     Float?
  longitude    Float?
  status       JobStatus @default(OPEN)
  isEvergreen  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mrfId Int?
  mrf   ManpowerRequest? @relation(fields: [mrfId], references: [id])

  applications Application[]
  walkInCheckIns WalkInCheckIn[]
  candidateScores CandidateScore[]
  scoringRevalidationTasks ScoringRevalidationTask[]
  talentPoolContacts TalentPoolContact[]
  talentPoolInvitations TalentPoolInvitation[]
  savedBy SavedJob[]
}

// ─────────────────────────────────────────────
// SAVED JOB / FAVORITES
// Candidate bookmarks for job openings to apply later.
// ─────────────────────────────────────────────

model SavedJob {
  id           Int        @id @default(autoincrement())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId Int
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, jobPostingId])
  @@index([userId])
  @@index([jobPostingId])
}

// ─────────────────────────────────────────────
// APPLICATION
// The bridge between an Applicant and a Job Posting.
// This is the most important table in the system.
// ─────────────────────────────────────────────

model Application {
  id           Int        @id @default(autoincrement())
  userId       String     // UUID — matches User.id from Supabase Auth
  user         User       @relation(fields: [userId], references: [id])
  jobPostingId Int
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])

  attemptNumber Int @default(1)

  // How the application reached MEGS. Staff-encoded walk-ins get a tracking code
  // for the printed QR slip; online ones do not.
  source            ApplicationSource @default(ONLINE)
  trackingCode      String?           @unique // e.g. WLK-2026-0042
  trackingTokenHash String?           // sha256 of the slip token; the raw token is only printed
  selfEncoded       Boolean           @default(false) // the applicant typed the details at a check-in; a TA confirmed them

  status    ApplicationStatus @default(SUBMITTED)
  resumeUrl String?           // Supabase Storage URL of uploaded resume
  aiScore   Float?            // 0–100 score returned by Gemini API
  aiSummary String?           // Gemini's parsed summary of the resume

  // Soft delete / archive
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // Contract signing (paper contract, signed scan kept by the TA only)
  contractSigned         Boolean   @default(false)
  contractSignedAt       DateTime?
  contractNotes          String?
  contractStartDate      DateTime?
  contractSignedById     String?
  contractDocumentId     Int?

  // Contract signing appointment. One pair = one active appointment; history lives in
  // RescheduleRequest rows and the audit log.
  contractSigningAt       DateTime?
  contractSigningLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  interviews        Interview[]
  postHireDocuments PostHireDocument[]
  hiredEmployee     Employee?   @relation("OriginatingApplication")
  candidateScores   CandidateScore[]
  scoringRevalidationTasks ScoringRevalidationTask[]
  storedDocuments StoredDocument[]
  recruiterDecisions RecruiterDecision[]
  complianceRequirements ComplianceRequirement[]
  deployments Deployment[]
  clientEndorsements ClientEndorsement[]
  backout ApplicationBackout?
  closures ApplicationClosure[]
  walkInCheckIn WalkInCheckIn?
  rescheduleRequests RescheduleRequest[]
  talentPoolMembershipsSourced TalentPoolMembership[] @relation("SourceApplication")

  @@unique([userId, jobPostingId, attemptNumber])
  @@index([userId, jobPostingId, createdAt(sort: Desc)])
  @@index([source])
}

enum ApplicationSource {
  ONLINE
  WALK_IN
}

// ─────────────────────────────────────────────
// INTERVIEW
// One application can have multiple interview stages.
// Tracks the 7-day compliance window.
// ─────────────────────────────────────────────

model Interview {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])

  type        InterviewType
  scheduledAt DateTime?
  conductedAt DateTime?
  result      String?   // "PASS" | "FAIL" | "PENDING"
  location    String?   // Where the interview happens or the meeting link, set when scheduling
  notes       String?   // Outcome notes, written when the result is recorded

  // 7-day compliance — TA must act within 7 days of interview
  complianceDeadline DateTime?
  isCompliant        Boolean?

  // Soft delete
  isActive Boolean @default(true)

  rescheduleRequests RescheduleRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// RESCHEDULE REQUEST
// An applicant asks for a new time for an interview or the contract signing.
// The rows double as the reschedule history for all three activities.
// ─────────────────────────────────────────────

model RescheduleRequest {
  id                  Int              @id @default(autoincrement())
  applicationId       Int
  application         Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  activity            ScheduleActivity
  interviewId         Int?             // set for interviews, null for contract signing
  interview           Interview?       @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  reason              String
  previousScheduledAt DateTime
  status              RescheduleStatus @default(PENDING)
  requestedById       String           // applicant user id
  decidedById         String?          // TA user id
  decidedAt           DateTime?
  decisionNote        String?
  newScheduledAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // One PENDING request per (applicationId, activity) is enforced by a partial unique index in the migration.
  @@index([applicationId, activity, status])
}

// ─────────────────────────────────────────────
// CLIENT ENDORSEMENT
// Evaluation and feedback from client between Initial Screening and Final Interview
// ─────────────────────────────────────────────

model ClientEndorsement {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  clientId      Int
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  outcome       String      @default("PENDING") // PENDING, ENDORSED, DECLINED
  endorsedById  String?
  endorsedBy    User?       @relation("EndorsementActor", fields: [endorsedById], references: [id])
  notes         String?     // written when the TA sends the candidate to the client
  decisionNotes String?     // written when the TA records the client's decision
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, outcome])
  @@index([clientId, outcome])
}

// ─────────────────────────────────────────────
// POST-HIRE DOCUMENT
// Documents submitted by applicant after receiving a job offer.
// ─────────────────────────────────────────────

model PostHireDocument {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])

  label   String
  fileUrl String  // Supabase Storage URL
  notes   String?

  // Soft delete
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// RECRUITER DECISION
// Audit trail of status transitions with actor and reason
// ─────────────────────────────────────────────

model RecruiterDecision {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actorId       String
  actor         User        @relation("DecisionActor", fields: [actorId], references: [id])
  fromStatus    String
  toStatus      String
  reason        String?
  transitionType String   @default("NORMAL") // NORMAL | SKIP | FAST_TRACK
  skippedStages String[]  @default([])
  reasonCode    String?   // Structured rejection reason (e.g. QUALIFICATIONS_MISMATCH)
  isReverted    Boolean   @default(false)
  revertedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}

// ─────────────────────────────────────────────
// COMPLIANCE REQUIREMENT
// Pre-employment checklist with review status
// ─────────────────────────────────────────────

model ComplianceRequirement {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  documentLabel String
  isRequired    Boolean     @default(true)
  deadline      DateTime?
  documentId    Int?
  reviewStatus  String      @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED, EXPIRED
  toFollowExpectedAt DateTime?
  reviewedById  String?
  reviewedBy    User?       @relation("ComplianceReviewer", fields: [reviewedById], references: [id])
  reviewNotes   String?
  reviewedAt    DateTime?
  expiresAt     DateTime?
  issuedAt      DateTime?
  validityStatus DocumentValidityStatus @default(UNKNOWN)
  updateRequestedAt DateTime?
  updateRequestReason String?
  updateRequestDeadline DateTime?
  updateRequestCompletedAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  documentVersions ComplianceDocumentVersion[]

  @@index([applicationId, reviewStatus])
}


// ─────────────────────────────────────────────
// APPLICATION BACKOUT
// Structured record of an applicant leaving the pipeline voluntarily or
// because the client/agency pulled out, before the deployment starts.
// Rejections stay on RecruiterDecision; post-start exits stay on Deployment.
// ─────────────────────────────────────────────

enum BackoutParty {
  APPLICANT
  CLIENT
  AGENCY
}

enum BackoutReason {
  NO_SHOW
  ACCEPTED_OTHER_OFFER
  SALARY_OR_BENEFITS
  LOCATION_OR_COMMUTE
  FAMILY_OR_PERSONAL
  HEALTH
  UNREACHABLE
  INCOMPLETE_REQUIREMENTS
  CLIENT_CANCELLED_REQUEST
  CLIENT_WITHDREW_SELECTION
  POSITION_FILLED
  AGENCY_PROCESSING_DELAY
  OTHER
}

model ApplicationBackout {
  id            Int               @id @default(autoincrement())
  applicationId Int               @unique
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  deploymentId  Int?
  stage         ApplicationStatus // Stage the application was in when the backout happened
  party         BackoutParty
  reason        BackoutReason
  notes         String?
  occurredAt    DateTime          // When it happened (may predate recordedAt)
  recordedById  String
  recordedBy    User              @relation("BackoutRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([occurredAt])
  @@index([stage])
  @@index([party])
}

// ─────────────────────────────────────────────
// APPLICATION CLOSURE
// One record per closed application: Rejected or Backed Out, plus the disposition
// (Talent Pool or Archive). Disposition is a choice, not a hiring stage.
// The migration also adds a partial unique index on (applicationId) WHERE reopenedAt IS NULL
// so only one live closure exists per application. Prisma cannot express it here.
// ─────────────────────────────────────────────

enum ClosureOutcome {
  REJECTED
  BACKED_OUT
}

enum ClosureDisposition {
  TALENT_POOL
  ARCHIVE
}

model ApplicationClosure {
  id            Int                 @id @default(autoincrement())
  applicationId Int
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  outcome       ClosureOutcome
  disposition   ClosureDisposition? // null only for legacy rows closed before dispositions existed
  stage         ApplicationStatus   // hiring stage when it was closed
  reasonCode    String
  notes         String?
  occurredAt    DateTime
  recordedById  String
  recordedBy    User                @relation("ClosureRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime            @default(now())
  reopenedAt    DateTime?

  @@index([applicationId])
  @@index([outcome])
  @@index([disposition])
  @@index([stage])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────
// WALK-IN CHECK-IN
// An applicant scans the MEGS poster QR and types their own details.
// Nothing else exists until any TA confirms it at the desk; then createWalkIn
// makes the User, profile and Application. Unconfirmed rows expire after 3 days.
// ─────────────────────────────────────────────

enum WalkInCheckInStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model WalkInCheckIn {
  id            Int                 @id @default(autoincrement())
  publicId      String              @unique @default(uuid())
  queueDate     DateTime            @db.Date // Manila calendar day
  queueSeq      Int                 // per-day number, shown as A-001

  jobPostingId  Int
  jobPosting    JobPosting          @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  firstName     String
  middleName    String?
  lastName      String
  mobileNumber  String?             // E.164
  birthDate     DateTime            @db.Date

  // Optional biodata photo or PDF the applicant attached. Held in private storage
  // (no StoredDocument yet, since no User exists) and moved into the new account on confirm.
  biodataStoragePath String?
  biodataMimeType    String?
  biodataFileName    String?
  biodataSizeBytes   Int?

  status        WalkInCheckInStatus @default(PENDING)
  viewTokenHash String              // sha256 of the token in the applicant's phone link

  confirmedById String?
  confirmedBy   User?               @relation("CheckInConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  applicationId Int?                @unique
  application   Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  dismissedById String?
  dismissedBy   User?               @relation("CheckInDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  dismissReason String?

  createdAt     DateTime            @default(now())
  expiresAt     DateTime
  updatedAt     DateTime            @updatedAt

  @@unique([queueDate, queueSeq])
  @@index([status, expiresAt])
}
