generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  // We are using PostgreSQL hosted on Supabase.
  // In Prisma 7, the connection URL is no longer set here.
  // It is configured in prisma.config.ts instead.
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  APPLICANT
  TALENT_ACQUISITION
  ADMINISTRATOR
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED         // Applicant just applied
  PARSING           // Gemini API is processing the resume
  REVIEW            // AI analysis completed, awaiting TA review
  NEEDS_ATTENTION   // Parsing or scoring error, requires manual intervention
  MATCHED           // Resume matched the job requirements
  TALENT_POOL       // Did not match — pooled for future roles
  INITIAL_SCREENING // First interview stage
  CLIENT_ENDORSEMENT // Client endorsement evaluation stage
  FINAL_INTERVIEW   // Final interview stage
  HIRED             // Offer accepted / hired as employee
  ONBOARDING        // Legacy state
  COMPLIANCE        // Pre-employment compliance document verification stage
  CONTRACT_SIGNING // Paper contract is filled, wet-signed and the signed scan uploaded
  DEPLOYED          // Candidate is actively deployed
  BACKOUT           // Candidate withdrew
  REJECTED          // TA turned the candidate down (disposition lives on ApplicationClosure)
  ARCHIVED          // Legacy: discarded / no longer active. New closures set isArchived instead.
}

enum DocumentValidityStatus {
  UNKNOWN
  HAS_EXPIRY
  NO_EXPIRY
}

enum InterviewType {
  INITIAL_SCREENING
  FINAL_INTERVIEW
}

// The three appointments an applicant can ask to reschedule.
enum ScheduleActivity {
  INITIAL_SCREENING
  FINAL_INTERVIEW
  CONTRACT_SIGNING
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}
