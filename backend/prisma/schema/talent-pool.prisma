// ─────────────────────────────────────────────
// TALENT POOL & RECRUITER CONTACTS
// Reusable recruiter-managed candidate pool
// ─────────────────────────────────────────────

enum TalentPoolStatus {
  ACTIVE
  PLACED
  INACTIVE
  ARCHIVED
}

enum CandidateAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum TalentPoolContactOutcome {
  INTERESTED
  NOT_INTERESTED
  NO_RESPONSE
  UNAVAILABLE
}

model TalentPoolMembership {
  id                  Int                   @id @default(autoincrement())
  applicantProfileId  Int                   @unique
  applicantProfile    ApplicantProfile      @relation(fields: [applicantProfileId], references: [id], onDelete: Restrict)

  sourceApplicationId Int?
  sourceApplication   Application?          @relation("SourceApplication", fields: [sourceApplicationId], references: [id], onDelete: SetNull)

  status              TalentPoolStatus      @default(ACTIVE)
  availability        CandidateAvailability @default(UNKNOWN)

  addedById           String
  addedBy             User                  @relation("PoolAddedBy", fields: [addedById], references: [id])
  addedAt             DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  lastContactedAt     DateTime?
  notes               String?

  contacts            TalentPoolContact[]
  invitations         TalentPoolInvitation[]

  @@index([status, availability])
}

enum TalentPoolInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum InvitationChannel {
  PORTAL
  SMS_MAGIC_LINK
  ASSISTED_PHONE
  IN_PERSON
}

model TalentPoolInvitation {
  id                 Int                        @id @default(autoincrement())
  applicantProfileId Int
  applicantProfile   ApplicantProfile           @relation(fields: [applicantProfileId], references: [id], onDelete: Cascade)

  membershipId       Int?
  membership         TalentPoolMembership?      @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  jobPostingId       Int
  jobPosting         JobPosting                 @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  invitedById        String
  invitedBy          User                       @relation("InvitationRecruiter", fields: [invitedById], references: [id])

  status             TalentPoolInvitationStatus @default(PENDING)
  message            String?
  declineReason      String?
  responseNotes      String?
  expiresAt          DateTime?
  respondedAt        DateTime?

  // How the reply arrived. Walk-ins without a portal account answer by phone,
  // in person (recorded by the TA in assistedById) or through a texted link.
  responseChannel    InvitationChannel          @default(PORTAL)
  assistedById       String?
  assistedBy         User?                      @relation("InvitationAssistedBy", fields: [assistedById], references: [id], onDelete: SetNull)
  responseTokenHash  String?                    // sha256 of the texted link token; cleared once used

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([applicantProfileId, status])
  @@index([membershipId, status])
  @@index([jobPostingId, status])
  @@index([status, createdAt(sort: Desc)])
}

model TalentPoolContact {
  id           Int                      @id @default(autoincrement())
  membershipId Int
  membership   TalentPoolMembership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  jobPostingId Int
  jobPosting   JobPosting               @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  recruiterId  String
  recruiter    User                     @relation("ContactRecruiter", fields: [recruiterId], references: [id])

  outcome      TalentPoolContactOutcome
  notes        String?
  contactedAt  DateTime                 @default(now())

  @@index([membershipId, contactedAt(sort: Desc)])
  @@index([jobPostingId])
}
