// ─────────────────────────────────────────────
// USER
// Every person who logs in — applicants AND staff.
// Auth data only. Personal details go in ApplicantProfile.
// ─────────────────────────────────────────────

model User {
  // UUID from Supabase auth.users — synced on registration, not auto-generated here
  id    String @id
  email String @unique
  phoneNumber String? @unique

  role Role @default(APPLICANT)

  // Soft delete — deactivate instead of erase
  isActive Boolean @default(true)

  // Account Status & Setup
  // ACTIVE | PENDING_VERIFICATION | PENDING | INVITED | DEACTIVATED | WALK_IN.
  // WALK_IN: encoded by a TA with no portal login yet (synthetic email); becomes ACTIVE when the applicant claims it.
  accountStatus String @default("ACTIVE")
  mustChangePassword Boolean @default(false)
  invitedAt DateTime?
  invitedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applicantProfile ApplicantProfile?
  applications     Application[]
  jobPostings      JobPosting[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  scoringConfigurationsCreated CandidateScoringConfiguration[] @relation("ScoringConfigurationCreatedBy")
  scoringConfigurationsActivated CandidateScoringConfiguration[] @relation("ScoringConfigurationActivatedBy")
  storedDocuments StoredDocument[]
  createdMRFs ManpowerRequest[] @relation("MRFCreatedBy")
  assignedMRFs ManpowerRequest[] @relation("MRFAssignedTa")
  assignedClients Client[] @relation("ClientAssignedTa")
  recruiterDecisions RecruiterDecision[] @relation("DecisionActor")
  recordedBackouts ApplicationBackout[] @relation("BackoutRecordedBy")
  recordedClosures ApplicationClosure[] @relation("ClosureRecordedBy")
  endorsedCandidates ClientEndorsement[] @relation("EndorsementActor")
  reviewedComplianceRequirements ComplianceRequirement[] @relation("ComplianceReviewer")
  createdDeployments Deployment[] @relation("DeploymentCreatedBy")
  outboxNotifications NotificationOutbox[] @relation("OutboxRecipient")
  deploymentStatusHistory DeploymentStatusHistory[] @relation("DeploymentHistoryActor")
  redeploymentEmployees Employee[] @relation("RedeploymentOwner")
  deploymentAgreementVersions DeploymentAgreementVersion[] @relation("DeploymentAgreementVersionActor")
  talentPoolMembershipsAdded TalentPoolMembership[] @relation("PoolAddedBy")
  talentPoolContacts TalentPoolContact[] @relation("ContactRecruiter")
  sentTalentPoolInvitations TalentPoolInvitation[] @relation("InvitationRecruiter")
  assistedInvitationReplies TalentPoolInvitation[] @relation("InvitationAssistedBy")
  confirmedCheckIns WalkInCheckIn[] @relation("CheckInConfirmedBy")
  dismissedCheckIns WalkInCheckIn[] @relation("CheckInDismissedBy")
  verifiedProfiles ApplicantProfile[] @relation("ProfileVerifiedBy")
  reviewedResumeParses ResumeParseResult[] @relation("ResumeParseReviewer")
  employee Employee? @relation("UserEmployee")
  employmentEventsCreated EmploymentEvent[] @relation("EmploymentEventActor")
  mfaRecoveryCodes UserMfaRecoveryCode[]
  invitations UserInvitation[]
  savedJobs SavedJob[]
  initiatedBackups DatabaseBackupRecord[]
  initiatedRestores DatabaseRestoreRecord[]
}

// ─────────────────────────────────────────────
// AUDIT LOG
// Immutable record of every important action.
// Never updated. Never deleted.
// ─────────────────────────────────────────────

model AuditLog {
  id     Int    @id @default(autoincrement())
  userId String? // UUID — matches User.id from Supabase Auth
  user   User?  @relation(fields: [userId], references: [id])

  action   String  // e.g. "LOGIN", "APPLY_JOB", "UPDATE_STATUS"
  entity   String? // e.g. "Application", "User"
  entityId Int?    // ID of the affected record
  details  String? // JSON string for extra context

  createdAt DateTime @default(now())
  @@index([action, createdAt])
  // No updatedAt — audit logs are never modified
}

// ─────────────────────────────────────────────
// NOTIFICATION
// Alerts sent to users (e.g., status updates, interview schedules).
// ─────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   // UUID of the recipient
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  type      String   // e.g., "INFO", "SUCCESS", "WARNING"
  isRead    Boolean  @default(false)
  link      String?  // Optional URL to redirect to when clicked
  dedupeKey String?  @unique // Set by scheduled reminders so a repeat run cannot send the same alert twice

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// NOTIFICATION OUTBOX
// Outbox pattern for email notifications
// ─────────────────────────────────────────────

model NotificationOutbox {
  id             Int       @id @default(autoincrement())
  recipientId    String
  recipient      User      @relation("OutboxRecipient", fields: [recipientId], references: [id])
  subject        String
  body           String
  channel        String    @default("EMAIL")
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  attempts       Int       @default(0)
  lastError      String?
  idempotencyKey String    @unique
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
// AUTH OTP & PASSWORD RESET SESSIONS
// ─────────────────────────────────────────────

model AuthOtp {
  id          Int      @id @default(autoincrement())
  email       String
  otpHash     String
  purpose     String   // "REGISTRATION" | "PASSWORD_RESET"
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([email, purpose, isUsed])
}

model PasswordResetSession {
  id        String   @id @default(uuid())
  userId    String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash, isUsed])
}

// ─────────────────────────────────────────────
// MFA RECOVERY CODES
// Single-use hashed backup codes for staff TOTP MFA
// ─────────────────────────────────────────────

model UserMfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isUsed])
}

// ─────────────────────────────────────────────
// USER INVITATIONS (TA ONBOARDING)
// Single-use hashed invitation tokens with explicit expiration
// ─────────────────────────────────────────────

model UserInvitation {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String    @unique
  expiresAt        DateTime
  isUsed           Boolean   @default(false)
  usedAt           DateTime?
  createdByAdminId String
  createdAt        DateTime  @default(now())

  @@index([tokenHash, isUsed])
  @@index([email, isUsed])
  @@index([userId, isUsed])
}

