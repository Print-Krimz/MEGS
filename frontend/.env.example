# ==============================================================================
# MEGS Frontend Environment Variables Template
# Copy this file to .env and configure as needed for your environment.
# ==============================================================================

# Backend API Base URL
VITE_API_URL="http://localhost:3000/api"

# Enable React Query Devtools in Development (true/false)
VITE_ENABLE_QUERY_DEVTOOLS="false"

# Cloudflare Turnstile CAPTCHA Site Key (Public)
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Optional CAPTCHA Disable Toggle (true/false) — Set to "true" to bypass widget
VITE_DISABLE_CAPTCHA="false"
